# Resend (contact form) — https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. Must be on a domain verified in the Resend dashboard.
# Leave unset to fall back to Resend's shared onboarding@resend.dev sender,
# which needs no verification but can ONLY deliver to the email address that
# owns the Resend account.
CONTACT_FROM_EMAIL=

# Where contact form submissions are delivered.
# Defaults to official.krtmiits@gmail.com when unset.
CONTACT_TO_EMAIL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
