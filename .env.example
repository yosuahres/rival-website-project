# Public origin of the deployed site, no trailing slash.
# Drives canonical URLs, the sitemap, robots.txt, and Open Graph image URLs.
# REQUIRED in production: until it is set the site serves `noindex` and a
# disallow-all robots.txt, so search engines will not index the site.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically if this is unset.
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# Server-side only. Used by the crowdfunding route handlers for the operations
# that must bypass RLS: deleting a donation and reading/writing transfer proofs
# in Storage, plus the /admin progress-bar update. Never expose this to the
# browser — it is deliberately not NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Duitku payment gateway (crowdfunding checkout) ──────────
# Merchant code + API key of one project from the Duitku merchant portal.
# Leave both blank to keep the manual QRIS + transfer-proof flow: the support
# page asks the server for payment methods and falls back automatically.
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=

# sandbox (default) targets https://sandbox.duitku.com, production targets
# https://passport.duitku.com. Sandbox and production have different keys.
DUITKU_ENV=sandbox

# Optional. Both default to NEXT_PUBLIC_SITE_URL and normally need no value.
# The callback URL is the one you must ALSO register in the Duitku merchant
# portal, and it has to keep its trailing slash — `trailingSlash: true` makes
# Next answer the slashless path with a 308 that Duitku does not follow.
#   Callback: https://<your-domain>/api/duitku/callback/
#   Return:   https://<your-domain>/crowdfunding/payment/
DUITKU_CALLBACK_URL=
DUITKU_RETURN_URL=

# Optional. Minutes a transaction stays payable. Left blank, Duitku applies
# its own per-channel default (VA channels are typically 24h, e-wallets much
# shorter). Setting a value above a channel's maximum makes it reject the
# transaction, so leave it alone unless you know the ceiling.
DUITKU_EXPIRY_MINUTES=
