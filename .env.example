# Public origin of the deployed site, no trailing slash.
# Drives canonical URLs, the sitemap, robots.txt, and Open Graph image URLs.
# REQUIRED in production: until it is set the site serves `noindex` and a
# disallow-all robots.txt, so search engines will not index the site.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically if this is unset.
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Used by the crowdfunding route handlers for the operations
# that must bypass RLS: deleting a donation and reading/writing transfer proofs
# in Storage, plus the /admin progress-bar update. Never expose this to the
# browser — it is deliberately not NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
