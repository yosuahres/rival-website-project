# Public origin of the deployed site, no trailing slash.
# Drives canonical URLs, the sitemap, robots.txt, and Open Graph image URLs.
# REQUIRED in production: until it is set the site serves `noindex` and a
# disallow-all robots.txt, so search engines will not index the site.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically if this is unset.
NEXT_PUBLIC_SITE_URL=

# Resend (contact form) — https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. Must be on a domain verified in the Resend dashboard.
# Leave unset to fall back to Resend's shared onboarding@resend.dev sender,
# which needs no verification but can ONLY deliver to the email address that
# owns the Resend account.
CONTACT_FROM_EMAIL=

# Where contact form submissions are delivered.
# Defaults to official.krtmiits@gmail.com when unset.
CONTACT_TO_EMAIL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
